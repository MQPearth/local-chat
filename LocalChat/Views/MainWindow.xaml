<Window x:Class="LocalChat.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="本地聊天" Height="760" Width="1160" MinHeight="600" MinWidth="940"
        WindowStartupLocation="CenterScreen" Background="#F7F8FA"
        Icon="pack://application:,,,/app.ico"
        FontFamily="Microsoft YaHei UI" FontSize="{DynamicResource UiFontDefault}" Foreground="#1F2328"
        UseLayoutRounding="True" TextOptions.TextRenderingMode="ClearType"
        PreviewMouseDown="Window_PreviewMouseDown">
    <Window.Resources>

        <!-- 用户气泡内文本:只读 TextBox,可自由选中复制 -->
        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="CaretBrush" Value="#F5F5F5"/>
            <Setter Property="SelectionBrush" Value="#7C9CFF"/>
            <Setter Property="SelectionOpacity" Value="0.55"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 用户消息气泡 -->
        <DataTemplate x:Key="UserMsgTemplate">
            <Grid Margin="0,5" HorizontalAlignment="Right" MaxWidth="620">
                <Border Background="#1C1C1E" CornerRadius="14" Padding="14,10" HorizontalAlignment="Right">
                    <TextBox Style="{StaticResource SelectableText}"
                             Text="{Binding Content, Mode=OneWay}"
                             IsReadOnly="True" IsTabStop="False"
                             FontSize="{DynamicResource ChatFontBody}" TextWrapping="Wrap"
                             HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- 压缩标记卡片:点击展开查看摘要文本 -->
        <DataTemplate x:Key="CompactMsgTemplate">
            <Expander Style="{StaticResource CleanExpander}" HorizontalAlignment="Left"
                      IsExpanded="{Binding IsThinkingOpen, Mode=OneWay}" Margin="0,5" MaxWidth="640">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🗜" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CompactHeaderText}" FontSize="{DynamicResource ChatFontMuted}"
                                   Foreground="#8A8F98"
                                   Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Expander.Header>
                <Border Background="#F7F7F8" BorderBrush="#E7EAED" BorderThickness="1"
                        CornerRadius="8" Padding="11,9" Margin="2,6,0,2">
                    <TextBlock Text="{Binding Content}" Foreground="#6F7680" FontSize="{DynamicResource ChatFontSecondary}"
                               TextWrapping="Wrap" LineHeight="{DynamicResource ChatLineSecondary}"/>
                </Border>
            </Expander>
        </DataTemplate>

        <!-- 助手消息气泡 -->
        <DataTemplate x:Key="AssistantMsgTemplate">
            <Grid Margin="0,5" MaxWidth="800" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" BorderBrush="#E7E9EC" BorderThickness="1" CornerRadius="14"
                        Padding="14,10" HorizontalAlignment="Left" MaxWidth="760">
                    <StackPanel>
                        <!-- 思考过程 -->
                        <Border Margin="0,0,0,6" Visibility="{Binding Reasoning, Converter={StaticResource EmptyToVis}}">
                            <Expander Style="{StaticResource CleanExpander}"
                                      IsExpanded="{Binding IsThinkingOpen, Mode=TwoWay}">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="💭" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ThinkingLabel}" Margin="6,0,0,0"
                                                   FontSize="{DynamicResource ChatFontMuted}" Foreground="#8A8F98" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Expander.Header>
                                <Border Background="#F7F7F8" CornerRadius="8" Padding="11,9" Margin="2,6,0,2">
                                    <TextBlock Text="{Binding Reasoning}" Foreground="#6F7680" FontSize="{DynamicResource ChatFontSecondary}"
                                               FontStyle="Italic" TextWrapping="Wrap" LineHeight="{DynamicResource ChatLineSecondary}"/>
                                </Border>
                            </Expander>
                        </Border>
                        <!-- 正文(Markdown 渲染的块元素) -->
                        <ItemsControl ItemsSource="{Binding Blocks}"/>
                        <TextBlock Text="正在生成…" Foreground="#9AA0A6" FontSize="{DynamicResource ChatFontSecondary}" Margin="0,2,0,0"
                                   Visibility="{Binding ShowWaiting, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>
                <!-- 悬停显示复制按钮(气泡右侧独立列,不遮挡内容) -->
                <Button Grid.Column="1" VerticalAlignment="Top" Margin="6,8,4,0"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE8C8;" FontSize="12"
                        ToolTip="复制回复"
                        Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Opacity" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </DataTemplate>

        <!-- 侧边栏会话条目 -->
        <DataTemplate x:Key="ConversationTemplate">
            <Border Background="Transparent" CornerRadius="10" Padding="12,9" Margin="4,1"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                <Border.ContextMenu>
                    <ContextMenu Opened="ConvMenu_Opened" Closed="ConvMenu_Closed">
                        <MenuItem Header="重命名"
                                  Command="{Binding PlacementTarget.Tag.RenameConversationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="删除对话"
                                  Command="{Binding PlacementTarget.Tag.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="导出 HTTP 数据"
                                  Command="{Binding PlacementTarget.Tag.ExportHttpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="{DynamicResource UiFontDefault}" FontWeight="SemiBold"
                               Foreground="#23272D" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding UpdatedAt, Converter={StaticResource TimeText}}"
                                   FontSize="{DynamicResource UiFontHint}" Foreground="#9AA0A6"/>
                        <TextBlock Text="{Binding MessageCountText}" FontSize="{DynamicResource UiFontHint}"
                                   Foreground="#9AA0A6" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="292" MinWidth="220" MaxWidth="520"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 侧边栏:聊天记录 ============ -->
        <Border Background="White" BorderBrush="#ECEEF1" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Padding="18,16,14,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💬" FontSize="17" VerticalAlignment="Center"/>
                        <TextBlock Text=" 本地聊天" FontSize="{DynamicResource UiFontTitle}" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Padding="12,4,12,10">
                    <Button Style="{StaticResource GhostButton}" Height="34" Command="{Binding NewChatCommand}"
                            ToolTip="开始一个新的对话">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="  新建对话" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>

                <ListBox Grid.Row="2" x:Name="ConvList"
                         ItemsSource="{Binding Conversations}"
                         SelectedItem="{Binding SelectedConversation}"
                         ItemTemplate="{StaticResource ConversationTemplate}"
                         Padding="4,0" Background="Transparent"/>

                <Border Grid.Row="3" Padding="16,8" BorderBrush="#ECEEF1" BorderThickness="0,1,0,0">
                    <TextBlock Text="{Binding Conversations.Count, StringFormat='{}{0} 个对话'}"
                               FontSize="{DynamicResource UiFontHint}" Foreground="#9AA0A6"/>
                </Border>
            </Grid>
        </Border>

        <!-- 侧边栏与主区域之间的拖动条 -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Auto" ShowsPreview="False"
                      ToolTip="拖动调整侧边栏宽度">
            <GridSplitter.Style>
                <Style TargetType="GridSplitter">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#E7E9EC"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </GridSplitter.Style>
        </GridSplitter>

        <!-- ============ 主区域 ============ -->
        <Border Grid.Column="2" Background="#F7F8FA">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶栏 -->
                <Border Background="White" BorderBrush="#ECEEF1" BorderThickness="0,0,0,1" Padding="18,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedConversation.Title, FallbackValue=本地聊天, TargetNullValue=本地聊天}"
                                       FontSize="{DynamicResource UiFontTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontSize="{DynamicResource UiFontHint}" Foreground="#9AA0A6" Margin="0,2,0,0">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}  ·  上下文 {1} tokens">
                                        <Binding Path="SelectedModel" FallbackValue="未选择模型" TargetNullValue="未选择模型"/>
                                        <Binding Path="SelectedModel.Model.ContextWindow" FallbackValue="-" TargetNullValue="-"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding SelectedModel}"
                                      MinWidth="240" MaxWidth="330" VerticalAlignment="Center"
                                      ToolTip="选择模型"/>
                            <Button Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets"
                                    Content="&#xE713;" FontSize="14" Margin="8,0,0,0"
                                    Command="{Binding OpenSettingsCommand}" ToolTip="设置"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 消息区 -->
                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0"
                                  ScrollChanged="ChatScroll_ScrollChanged">
                        <ItemsControl x:Name="MsgList" ItemsSource="{Binding SelectedConversation.Messages}" Margin="24,18">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding}">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="ContentTemplate" Value="{StaticResource AssistantMsgTemplate}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Role}" Value="user">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource UserMsgTemplate}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Role}" Value="compact">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource CompactMsgTemplate}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding SelectedConversation.Messages.Count, Converter={StaticResource ZeroCountToVis}}">
                        <TextBlock Text="💬" FontSize="46" HorizontalAlignment="Center"/>
                        <TextBlock Text="开始新的对话" FontSize="{DynamicResource UiFontHead}" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        <TextBlock Text="在下方输入消息开始 · 点击右上角齿轮配置大模型服务"
                                   FontSize="{DynamicResource UiFontSub}" Foreground="#9AA0A6" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 输入区 -->
                <Border Grid.Row="2" Margin="18,6,18,16" Background="White" BorderBrush="#E7E9EC"
                        BorderThickness="1" CornerRadius="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="InputBox" BorderThickness="0" Background="Transparent"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="46" MaxHeight="170"
                                 VerticalScrollBarVisibility="Auto" Padding="14,11,14,4" FontSize="{DynamicResource ChatFontBody}"
                                 PreviewKeyDown="InputBox_PreviewKeyDown"
                                 ToolTip="Enter 发送 · Shift+Enter 换行"/>
                        <Grid Grid.Row="1" Margin="12,2,12,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ToggleButton IsChecked="{Binding ThinkingEnabled}"
                                              Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                                <TextBlock Text="思考" FontSize="{DynamicResource UiFontSub}" Foreground="#374151"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource GhostButton}" Command="{Binding CompactContextCommand}"
                                        ToolTip="把对话历史压缩为一条摘要,减少上下文占用" Margin="16,0,0,0"
                                        Padding="10,5" FontSize="{DynamicResource UiFontSub}" VerticalAlignment="Center">
                                    <TextBlock Text="压缩上下文"/>
                                </Button>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="生成中,可点击右侧按钮停止" FontSize="{DynamicResource UiFontHint}"
                                       Foreground="#9AA0A6" VerticalAlignment="Center" Margin="16,0,0,0"
                                       Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVis}}"/>
                            <!-- 上下文用量环:已用估算 / 模型窗口 -->
                            <Grid Grid.Column="2" Width="26" Height="26" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Margin="0,0,8,0">
                                <Grid.ToolTip>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}已用约 {0} / {1} tokens(中文约 1 字 1 token,英文约 4 字符 1 token;取最近 30 条,与实际发送范围一致)">
                                                <Binding Path="SelectedConversation.EstimatedTokens" FallbackValue="0" TargetNullValue="0"/>
                                                <Binding Path="SelectedModel.Model.ContextWindow" FallbackValue="-" TargetNullValue="-"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid.ToolTip>
                                <Ellipse Stroke="#E5E7EA" StrokeThickness="4"/>
                                <Path Stroke="#6F7680" StrokeThickness="4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Path.Data>
                                        <MultiBinding Converter="{StaticResource RingArc}">
                                            <Binding Path="SelectedConversation.EstimatedTokens" FallbackValue="0" TargetNullValue="0"/>
                                            <Binding Path="SelectedModel.Model.ContextWindow" FallbackValue="0" TargetNullValue="0"/>
                                        </MultiBinding>
                                    </Path.Data>
                                </Path>
                            </Grid>
                            <Button Grid.Column="3" Command="{Binding SendCommand}" Click="SendBtn_Click"
                                    ToolTip="发送 (Enter)" Tag="19" Padding="0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Width" Value="38"/>
                                        <Setter Property="Height" Value="38"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="-90"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Button>
                            <Button Grid.Column="3" Command="{Binding StopCommand}" ToolTip="停止生成" Tag="19" Padding="0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Setter Property="Width" Value="38"/>
                                        <Setter Property="Height" Value="38"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStreaming}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Rectangle Width="13" Height="13" RadiusX="2.5" RadiusY="2.5" Fill="#1F2328"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
