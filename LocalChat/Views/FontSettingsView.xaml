<UserControl x:Class="LocalChat.Views.FontSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="#ECEEF1" BorderThickness="0,0,0,1" Padding="24,14">
            <StackPanel>
                <TextBlock Text="显示设置" FontSize="{DynamicResource UiFontTitle}" FontWeight="Bold"/>
                <TextBlock Text="调整界面与聊天区的文字大小,修改即时生效"
                           FontSize="{DynamicResource UiFontSub}" Foreground="#8A8F98" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="600" HorizontalAlignment="Left" Margin="24,20,24,24">
                <TextBlock Text="界面字体大小" FontWeight="Medium"/>
                <Grid Margin="0,10,0,0">
                    <Slider x:Name="UiSlider" Minimum="11" Maximum="20" TickFrequency="0.5"
                            IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"
                            VerticalAlignment="Center" Margin="0,0,48,0"/>
                    <TextBlock x:Name="UiValueText" Text="13" FontWeight="SemiBold" MinWidth="36"
                               TextAlignment="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="侧边栏、顶栏、按钮与设置窗口等界面文字"
                           FontSize="{DynamicResource UiFontSub}" Foreground="#8A8F98" Margin="0,8,0,0"/>

                <TextBlock Text="聊天区字体大小" FontWeight="Medium" Margin="0,26,0,0"/>
                <Grid Margin="0,10,0,0">
                    <Slider x:Name="ChatSlider" Minimum="11" Maximum="22" TickFrequency="0.5"
                            IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"
                            VerticalAlignment="Center" Margin="0,0,48,0"/>
                    <TextBlock x:Name="ChatValueText" Text="13.5" FontWeight="SemiBold" MinWidth="36"
                               TextAlignment="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="消息正文、输入框与代码块等聊天内容"
                           FontSize="{DynamicResource UiFontSub}" Foreground="#8A8F98" Margin="0,8,0,0"/>

                <Border Background="#F7F7F8" BorderBrush="#E7EAED" BorderThickness="1" CornerRadius="10"
                        Padding="14,11" Margin="0,24,0,0">
                    <StackPanel>
                        <TextBlock Text="聊天区预览:你好,这是一条示例消息 Aa 123"
                                   FontSize="{DynamicResource ChatFontBody}" TextWrapping="Wrap"/>
                        <TextBlock Text="代码预览:Console.WriteLine(&quot;Hello&quot;);"
                                   FontSize="{DynamicResource ChatFontSecondary}" Foreground="#6F7680"
                                   Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource LinkButton}" Content="恢复默认"
                        HorizontalAlignment="Left" Margin="4,20,0,0" Click="Reset_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
